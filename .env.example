# ---- Redis (Upstash) ----
REDIS_URL="redis://default:[YOUR-PASSWORD]@[YOUR-HOST].upstash.io:6379"

# ---- Sentry ----
SENTRY_DSN="https://[YOUR-DSN]@[YOUR-HOST].ingest.sentry.io/[YOUR-PROJECT-ID]"

# ---- WhatsApp Provider ----
# Options: "mock" | "baileys" | "cloud-api"
WHATSAPP_PROVIDER="mock"
WHATSAPP_SESSION_PATH="./whatsapp-session"

# ---- WhatsApp Business Cloud API (for future production use) ----
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""
META_VERIFY_TOKEN=""

# ---- Send Rate Limits ----
# Default daily cap for new contact messages
SEND_DAILY_CAP="30"
# Min/max delay in seconds between sends (randomized)
SEND_DELAY_MIN_SEC="30"
SEND_DELAY_MAX_SEC="120"

# ---- Phone Normalization ----
# Default country code when a number has no country code
# e.g. "IN" for India, "US" for United States
DEFAULT_COUNTRY_CODE="IN"
