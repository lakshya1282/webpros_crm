{
  "name": "whatsapp-crm",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @whatsapp-crm/db generate",
    "db:migrate": "pnpm --filter @whatsapp-crm/db migrate:dev",
    "db:push": "pnpm --filter @whatsapp-crm/db db:push",
    "db:studio": "pnpm --filter @whatsapp-crm/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.1"
  }
}
